---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{%- assign items = site.entries | sort: "updated", "last" | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html" hreflang="en"/>
  <id>{{ site.url }}/feed.xml</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
  </author>
  {%- for e in items limit: 50 %}
  <entry>
    <title>{{ e.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ e.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ e.url }}</id>
    <updated>{{ e.updated | default: e.incident_date | date_to_xmlschema }}</updated>
    <summary type="html">{{ e.summary | xml_escape }}</summary>
    <content type="html">{{ e.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
